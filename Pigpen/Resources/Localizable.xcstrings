    "The best pen was already his. Plenty of space. Apples nearby. No fine print.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best pen was already his. Plenty of space. Apples nearby. No fine print."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das beste Gehege gehörte ihm längst. Viel Platz. Äpfel in der Nähe. Kein Kleingedrucktes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mejor corral ya era suyo. Espacio de sobra. Manzanas cerca. Sin letra pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur enclos était déjà le sien. De l'espace. Des pommes à côté. Aucune clause en petits caractères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recinto migliore era già suo. Tanto spazio. Mele lì accanto. Nessuna clausola nascosta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最良の囲いは、すでに彼のものでした。広さ十分。リンゴも近く。小さな文字の但し書きもなし。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O melhor curral já era dele. Espaço de sobra. Maçãs por perto. Sem letras miúdas."
          }
        }
      }
    },

    "Pig gets his own pen. Both %@ share the other. Pig was absolutely not accepting roommates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig gets his own pen. Both %@ share the other. Pig was absolutely not accepting roommates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig bekommt sein eigenes Gehege. Die beiden %@ teilen sich das andere. Mitbewohner kamen für Pig absolut nicht infrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig tiene su propio corral. Los dos %@ comparten el otro. Pig no pensaba aceptar compañeros de piso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig a son propre enclos. Les deux %@ partagent l'autre. Pig n'acceptait absolument pas de colocataires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig ha il suo recinto. I due %@ condividono l'altro. Pig non accettava assolutamente coinquilini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig は自分の囲いを。%@は二匹でもう一つを共有。Pig は同居を断固拒否。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig fica com o próprio curral. Os dois %@ dividem o outro. Pig não aceitava colegas de quarto de jeito nenhum."
          }
        }
      }
    },

    "Fence in Pig. Keep every piece of fence out of the eagle's line of sight. The homeowners association is watching.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fence in Pig. Keep every piece of fence out of the eagle's line of sight. The homeowners association is watching."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zäune Pig ein. Kein Stück Zaun darf in die Sichtlinie des Adlers geraten. Die Eigentümergemeinschaft schaut zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encierra a Pig. Que ninguna pieza de valla quede en la línea de visión del águila. La comunidad de propietarios vigila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enferme Pig. Qu'aucun morceau de clôture ne soit dans la ligne de mire de l'aigle. Le syndic surveille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recinta Pig. Nessun pezzo di recinzione deve stare nella linea di vista dell'aquila. Il condominio vigila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig を囲う。柵のどの一片もワシの視線に入らないこと。自治会が見ています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerque Pig. Nenhum pedaço de cerca pode ficar na linha de visão da águia. A associação de moradores está de olho."
          }
        }
      }
    },

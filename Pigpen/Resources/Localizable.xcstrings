    "%lld outfits on the wall, and the bare peg she arrived on. Whatever is on her in there, she wears it on every board.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld outfits on the wall, and the bare peg she arrived on. Whatever is on her in there, she wears it on every board."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Kostüme an der Wand, dazu der leere Haken, an dem sie ankam. Was sie dort anhat, trägt sie auf jedem Feld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld atuendos en la pared, más la percha vacía con la que llegó. Lo que lleve puesto allí, lo lleva en cada tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tenues au mur, plus la patère nue où elle est arrivée. Ce qu'elle porte là, elle le porte sur chaque plateau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld completi alla parete, più il gancio vuoto con cui è arrivata. Quello che indossa lì, lo indossa su ogni tabellone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁に%lld着の衣装、そして到着時の空のハンガー。そこで着たものは、どの盤面でも身につけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld trajes na parede, mais o gancho vazio em que ela chegou. O que estiver nela lá, ela usa em todos os tabuleiros."
          }
        }
      }
    },

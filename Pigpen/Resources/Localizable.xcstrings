    "Water access is worth a premium. Snakes tend to hurt buyer confidence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water access is worth a premium. Snakes tend to hurt buyer confidence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasserzugang bringt einen Aufschlag. Schlangen schaden dem Käufervertrauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al agua se paga. Las serpientes minan la confianza del comprador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'eau se paie. Les serpents entament la confiance de l'acheteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso all'acqua vale un sovrapprezzo. I serpenti minano la fiducia dell'acquirente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水辺へのアクセスは付加価値。ヘビは購入意欲を削ぎます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso à água vale um prêmio. Cobras costumam abalar a confiança do comprador."
          }
        }
      }
    },

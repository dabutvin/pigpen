    "Release the pig. Earn up to 3 stars. More space + bonuses = a better score.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the pig. Earn up to 3 stars. More space + bonuses = a better score."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Schwein los. Hol dir bis zu 3 Sterne. Mehr Fläche + Boni = mehr Punkte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta al cerdo. Consigue hasta 3 estrellas. Más espacio + bonus = mejor puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâche le cochon. Gagne jusqu'à 3 étoiles. Plus d'espace + bonus = meilleur score."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera il maiale. Guadagna fino a 3 stelle. Più spazio + bonus = punteggio migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブタを放ちます。最大3つ星。広さ＋ボーナスで高得点。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte o porco. Ganhe até 3 estrelas. Mais espaço + bônus = melhor pontuação."
          }
        }
      }
    },

        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, unos %@ en total, incluidos los mundos a los que aún no has llegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, environ %@ en tout — y compris les mondes que tu n'as pas encore atteints."

    "Waiting on approval. The full game opens as soon as it comes through — nothing more to do here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting on approval. The full game opens as soon as it comes through — nothing more to do here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf die Freigabe. Die Vollversion öffnet, sobald sie durch ist — hier ist nichts weiter zu tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. El juego completo se abrirá en cuanto llegue: aquí no hay nada más que hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation. Le jeu complet s'ouvrira dès qu'elle arrivera — rien de plus à faire ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Il gioco completo si apre appena arriva — qui non c'è altro da fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。通り次第フルゲームが開きます。ここでできることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. O jogo completo abre assim que ela sair — não há mais nada a fazer aqui."
          }
        }
      }
    },

        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas Gemütliches nahe der Piste klang unschlagbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sitio acogedor cerca de las pistas sonaba difícil de superar."
          }

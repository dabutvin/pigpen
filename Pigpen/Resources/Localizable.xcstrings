      }
    },
    "Every film in the game, one after another: the opening, the boss briefing and the send-off of every world there is. Tap to move on, swipe back for the one before.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every film in the game, one after another: the opening, the boss briefing and the send-off of every world there is. Tap to move on, swipe back for the one before."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Film im Spiel, einer nach dem anderen: Auftakt, Boss-Einweisung und Abschied jeder Welt, die es gibt. Tippen für den nächsten, zurückwischen für den davor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las películas del juego, una tras otra: la apertura, las instrucciones del jefe y la despedida de cada mundo que existe. Toca para avanzar, desliza atrás para la anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les films du jeu, l'un après l'autre : l'ouverture, le briefing du boss et l'au revoir de chaque monde. Touche pour avancer, balaie en arrière pour le précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i filmati del gioco, uno dopo l'altro: apertura, istruzioni del boss e commiato di ogni mondo che c'è. Tocca per andare avanti, scorri indietro per il precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内のすべての映像を続けて。各世界のオープニング、ボスのブリーフィング、そして見送り。タップで次へ、スワイプで前へ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os filmes do jogo, um após o outro: a abertura, as instruções do chefe e a despedida de cada mundo que existe. Toque para avançar, deslize para trás para o anterior."
          }
        }
      }
    },
    "Every level, right away": {

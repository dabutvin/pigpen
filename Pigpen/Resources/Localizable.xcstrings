    "Build Pig and %@ separate pens. And don't let them share a fence. Adjoining properties were not approved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build Pig and %@ separate pens. And don't let them share a fence. Adjoining properties were not approved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau getrennte Gehege für Pig und %@. Und sie dürfen sich keinen Zaun teilen. Reihenbauweise wurde nicht genehmigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye corrales separados para Pig y %@. Y que no compartan valla. Las viviendas adosadas no se aprobaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis des enclos séparés pour Pig et %@. Et pas de clôture mitoyenne. Le mitoyen n'a pas été approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci recinti separati per Pig e %@. E niente recinzione in comune. Le proprietà attigue non sono state approvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig と%@に別々の囲いを。柵の共有も不可。隣接物件は不承認。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa currais separados para Pig e %@. E nada de cerca compartilhada. Imóveis geminados não foram aprovados."
          }
        }
      }
    },
    "Build Pig and %@ separate pens. Fence %@ in with one entire waterway.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

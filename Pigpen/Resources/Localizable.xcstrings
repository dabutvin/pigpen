          }
        }
      }
    },
    "A one-time purchase. Restores free on every device you sign in to.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time purchase. Restores free on every device you sign in to."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Бесплатно восстанавливается на любом устройстве, где ты вошёл в свой аккаунт."
          }
        }
      }
    },
    "A pen worth bragging about.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pen worth bragging about."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таким загоном можно хвастаться."
          }
        }
      }
    },
    "A rainbow adds instant appeal. Severe weather is a notable drawback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rainbow adds instant appeal. Severe weather is a notable drawback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Радуга сразу добавляет очарования. Суровая погода — заметный недостаток."
          }
        }
      }
    },
    "A reminder at %@ on any morning you have not yet finished the day's puzzle, and one the moment your next free level opens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder at %@ on any morning you have not yet finished the day's puzzle, and one the moment your next free level opens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание в %@ каждое утро, если головоломка дня ещё не решена, и ещё одно — как только откроется следующий бесплатный уровень."
          }
        }
      }
    },
    "A reminder at %@ on any morning you have not yet finished the day's puzzle.": {
      "extractionState": "manual",
      "localizations": {

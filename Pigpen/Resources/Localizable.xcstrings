    "Everything is held, but the roost is split between two places. %@ lives where the other bat lives.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is held, but the roost is split between two places. %@ lives where the other bat lives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles hält, aber der Schlafplatz liegt in zwei Gehegen. %@ wohnt dort, wo die andere Fledermaus wohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo aguanta, pero el dormidero queda repartido en dos sitios. %@ vive donde vive el otro murciélago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout tient, mais le perchoir est réparti sur deux enclos. %@ vit là où vit l'autre chauve-souris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regge tutto, ma il posatoio è diviso fra due recinti. %@ vive dove vive l'altro pipistrello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて囲えていますが、ねぐらが二つに分かれています。%@はもう一匹と同じ場所に住みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo se sustenta, mas o poleiro ficou dividido em dois lugares. %@ mora onde mora o outro morcego."
          }
        }
      }
    },
    "Excellent mineral rights. Boulders make expansion difficult.": {
      "extractionState": "manual",
      "localizations": {

    "Welcome to Mudlark Meadow. Use the fence you're given to build Pig the biggest pen you can.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Mudlark Meadow. Use the fence you're given to build Pig the biggest pen you can."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen in Mudlark Meadow. Bau Pig mit dem gegebenen Zaun das größte Gehege, das du schaffst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido a Mudlark Meadow. Con la valla que te dan, constrúyele a Pig el corral más grande que puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue à Mudlark Meadow. Avec la clôture fournie, construis à Pig le plus grand enclos possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto a Mudlark Meadow. Con la recinzione che ti viene data, costruisci a Pig il recinto più grande che puoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow へようこそ。与えられた柵で、Pig にできるだけ広い囲いを。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo a Mudlark Meadow. Com a cerca que você recebe, construa para Pig o maior curral possível."
          }
        }
      }
    },

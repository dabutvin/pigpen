        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns out the mineral rights have their perks. Open flames are a maintenance concern."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schürfrechte haben durchaus Vorzüge. Offene Flammen sind ein Instandhaltungsthema."
          }
        },
        "es": {

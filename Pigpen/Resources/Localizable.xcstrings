    "Lantern Carnival. Bright. Bustling. Absolutely no shortage of entertainment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival. Bright. Bustling. Absolutely no shortage of entertainment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival. Hell. Belebt. An Unterhaltung mangelt es keineswegs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival. Luminoso. Animado. Ocio de sobra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival. Lumineux. Animé. Aucun manque de divertissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival. Luminoso. Animato. Intrattenimento in abbondanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival。明るく、にぎやか。娯楽に事欠きません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern Carnival. Iluminado. Movimentado. Diversão de sobra."
          }
        }
      }
    },

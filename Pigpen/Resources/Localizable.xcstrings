    "Lights, crowds and a pig on the loose. Popcorn in the sawdust, megaphones over it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lights, crowds and a pig on the loose. Popcorn in the sawdust, megaphones over it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichter, Gedränge und ein Schwein auf freiem Fuß. Popcorn im Sägemehl, Megafone darüber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luces, gentío y un cerdo suelto. Palomitas en el serrín, megáfonos por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des lumières, de la foule et un cochon en liberté. Du pop-corn dans la sciure, des mégaphones au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luci, folla e un maiale a piede libero. Popcorn nella segatura, megafoni sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光と人だかり、そして放たれたブタ。おがくずにポップコーン、その上にメガホン。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luzes, multidão e um porco solto. Pipoca na serragem, megafones por cima."
          }
        }
      }
    },

        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свинья ушла к лесу. Грибы в прелой листве, увядшие цветы в темноте."
          }
        }
      }
    },
    "The pig wearing the %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pig wearing the %@"

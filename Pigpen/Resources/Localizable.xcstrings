    "Where it all began. A pig, an open gate, and nine fields of nothing to stop it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it all began. A pig, an open gate, and nine fields of nothing to stop it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo alles anfing. Ein Schwein, ein offenes Tor und neun Felder ohne alles, was aufhielte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde empezó todo. Un cerdo, una puerta abierta y nueve campos sin nada que lo detenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où tout a commencé. Un cochon, un portail ouvert et neuf champs sans rien pour l'arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove tutto è cominciato. Un maiale, un cancello aperto e nove campi senza nulla a fermarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてはここから。ブタと開いた門、そして遮るもののない九つの野原。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde tudo começou. Um porco, um portão aberto e nove campos sem nada para detê-lo."
          }
        }
      }
    },
    "Where the tide keeps rearranging the walls.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the tide keeps rearranging the walls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo die Gezeiten die Wände immer wieder umstellen."
          }
        },
        "es": {

          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où la marée n'arrête pas de déplacer les murs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove la marea continua a spostare le pareti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "潮が壁を並べ替えつづける場所。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde a maré vive reorganizando as paredes."
          }
        }
      }
    },
    "Which puzzles get played and how they go — stars, scores, and how many tries a puzzle took. It shows which levels are too hard. No name, no account, no advertising identifier, and nothing that says who you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which puzzles get played and how they go — stars, scores, and how many tries a puzzle took. It shows which levels are too hard. No name, no account, no advertising identifier, and nothing that says who you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Rätsel gespielt werden und wie sie laufen — Sterne, Punkte und wie viele Versuche ein Rätsel gebraucht hat. Das zeigt, welche Ebenen zu schwer sind. Kein Name, kein Konto, keine Werbekennung und nichts, was sagt, wer du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué puzles se juegan y cómo van: estrellas, puntuaciones y cuántos intentos ha costado un puzle. Sirve para ver qué niveles son demasiado difíciles. Sin nombre, sin cuenta, sin identificador de publicidad y sin nada que diga quién eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quels puzzles sont joués et comment ils se passent — étoiles, scores, et combien d'essais un puzzle a demandés. Cela montre quels niveaux sont trop durs. Pas de nom, pas de compte, pas d'identifiant publicitaire, et rien qui dise qui tu es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali puzzle vengono giocati e come vanno — stelle, punteggi e quanti tentativi ha richiesto un puzzle. Serve a capire quali livelli sono troppo difficili. Nessun nome, nessun account, nessun identificatore pubblicitario e nulla che dica chi sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのパズルが遊ばれ、どう進んだか。星、スコア、何回で解けたか。難しすぎるレベルが分かります。名前もアカウントも広告IDもなく、あなたが誰かを示すものは含みません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais quebra-cabeças são jogados e como vão — estrelas, pontuações e quantas tentativas um quebra-cabeça levou. Mostra quais níveis estão difíceis demais. Sem nome, sem conta, sem identificador de publicidade e nada que diga quem você é."
          }
        }
      }
    },

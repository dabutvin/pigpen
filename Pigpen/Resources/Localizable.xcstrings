    "On-site concessions are a definite perk. The noise alone could sink the deal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-site concessions are a definite perk. The noise alone could sink the deal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stände vor Ort sind klar ein Plus. Allein der Lärm könnte den Kauf platzen lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puestos en la misma finca son una ventaja clara. El ruido, por sí solo, puede tumbar la operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stands sur place sont un vrai plus. Le bruit, à lui seul, peut faire capoter l'affaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I chioschi in loco sono un vantaggio netto. Il rumore, da solo, può far saltare l'affare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "敷地内の売店は明確な利点。騒音だけで商談が流れかねません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barracas no local são uma vantagem clara. Só o barulho já pode derrubar o negócio."
          }
        }
      }
    },

        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスをタップして柵を置きます。やってみましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma casa para colocar uma peça de cerca. Experimente."
          }
        }
      }
    },
    "Tap and drag across tiles to place several pieces at once. Give it a try.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and drag across tiles to place several pieces at once. Give it a try."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp und zieh über mehrere Kacheln, um mehrere Stücke auf einmal zu setzen. Probier es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y arrastra por las casillas para colocar varias piezas a la vez. Inténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche et fais glisser sur les cases pour poser plusieurs pièces d'un coup. Essaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e trascina sulle caselle per posare più pezzi in una volta. Provaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスをなぞると、まとめて柵を置けます。試してみましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e arraste pelas casas para colocar várias peças de uma vez. Experimente."
          }
        }
      }
    },
    "That didn't go through, and you have not been charged. Have another go in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't go through, and you have not been charged. Have another go in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ging nicht durch, und es wurde nichts abgebucht. Versuch es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha completado y no se te ha cobrado nada. Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça n'a pas abouti, et rien ne t'a été facturé. Réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è andata a buon fine e non ti è stato addebitato nulla. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しませんでした。請求もされていません。少ししてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi concluído, e nada foi cobrado. Tente de novo daqui a pouco."
          }
        }
      }
    },
    "That's it. Go give Pig some room to roam.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's it. Go give Pig some room to roam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war's. Und jetzt schaff Pig Auslauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es todo. Ahora dale a Pig sitio para corretear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est tout. Va donner à Pig de quoi gambader."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto qui. Ora dai a Pig un po' di spazio per girare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

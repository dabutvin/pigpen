    "Pizza within walking distance is a strong selling point. Trash pickup appears to be… irregular.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizza within walking distance is a strong selling point. Trash pickup appears to be… irregular."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizza in Gehweite ist ein starkes Argument. Die Müllabfuhr wirkt … unregelmäßig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tener pizza a pie es un buen argumento de venta. La recogida de basura parece… irregular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pizzeria à pied, c'est un vrai argument. Le ramassage des ordures semble… irrégulier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizza a due passi è un ottimo argomento. La raccolta rifiuti sembra… irregolare."
          }

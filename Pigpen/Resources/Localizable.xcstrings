          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchísimo mejor iluminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup, beaucoup mieux éclairé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molta, molta più luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はるかに、はるかに明るい場所。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito, muito melhor iluminação."
          }
        }
      }
    },
    "Mudlark Meadow had space. Good views. Plenty of apples.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow had space. Good views. Plenty of apples."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow hatte Platz. Gute Aussicht. Äpfel in Hülle und Fülle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow tenía espacio. Buenas vistas. Manzanas de sobra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow avait de l'espace. De belles vues. Des pommes à profusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow aveva spazio. Belle viste. Mele in abbondanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow は広く、眺めもよく、リンゴも豊富。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow tinha espaço. Boas vistas. Maçãs de sobra."
          }
        }
      }
    },
    "Mushrooms are a charming local amenity. Wilted flowers do nothing for curb appeal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mushrooms are a charming local amenity. Wilted flowers do nothing for curb appeal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilze sind ein charmantes Extra der Lage. Welke Blumen tun der Fassade nicht gut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las setas son un encanto local. Las flores marchitas no ayudan a la primera impresión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champignons font le charme du coin. Les fleurs fanées, elles, ne font rien pour l'allure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I funghi sono un piacevole servizio locale. I fiori appassiti non aiutano il colpo d'occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キノコは土地の魅力。しおれた花は第一印象を損ないます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cogumelos são um charme local. Flores murchas não ajudam na primeira impressão."
          }
        }
      }
    },

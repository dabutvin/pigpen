    "Help Pig explore the whole universe with no waiting. The free game opens one level a day past the meadow; this opens all of them at once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Pig explore the whole universe with no waiting. The free game opens one level a day past the meadow; this opens all of them at once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf Pig, das ganze Universum ohne Warten zu erkunden. Die kostenlose Version öffnet hinter der Wiese eine Ebene pro Tag; das hier öffnet alle auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Pig a recorrer todo el universo sin esperas. El juego gratuito abre un nivel al día pasado el prado; esto los abre todos de golpe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide Pig à explorer tout l'univers sans attendre. La version gratuite ouvre un niveau par jour après la prairie ; ceci les ouvre tous d'un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta Pig a esplorare tutto l'universo senza attese. La versione gratuita apre un livello al giorno dopo il prato; questa li apre tutti insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ち時間なしで、Pig と宇宙のすべてを回りましょう。無料版は草原の先を1日1レベルずつ開きますが、これはすべてを一度に開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude Pig a explorar todo o universo sem espera. O jogo gratuito abre um nível por dia depois do prado; isto abre todos de uma vez."
          }
        }
      }
    },

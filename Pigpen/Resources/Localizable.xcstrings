    "Build Pig and %@ two separate pens. They must be exactly the same size. Equal square footage. No exceptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build Pig and %@ two separate pens. They must be exactly the same size. Equal square footage. No exceptions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau zwei getrennte Gehege: eins für Pig, eins für %@. Exakt gleich groß. Gleiche Fläche. Keine Ausnahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye dos corrales separados: uno para Pig y otro para %@. Exactamente del mismo tamaño. Misma superficie. Sin excepciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis deux enclos séparés : un pour Pig, un pour %@. Exactement de la même taille. Même surface. Sans exception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci due recinti separati: uno per Pig, uno per %@. Esattamente della stessa misura. Stessa superficie. Nessuna eccezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

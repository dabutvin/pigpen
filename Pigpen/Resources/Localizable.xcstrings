    "Every star you have earned, every level you have opened and every daily puzzle you have finished will be forgotten, and %@ goes back to its first puzzle. There is no getting them back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every star you have earned, every level you have opened and every daily puzzle you have finished will be forgotten, and %@ goes back to its first puzzle. There is no getting them back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Stern, den du verdient hast, jede Ebene, die du geöffnet hast, und jedes Tagesrätsel, das du gelöst hast, wird vergessen, und %@ steht wieder bei seinem ersten Rätsel. Zurückholen lässt sich nichts davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estrella que has ganado, cada nivel que has abierto y cada puzle diario que has terminado se olvidará, y %@ vuelve a su primer puzle. No hay forma de recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque étoile gagnée, chaque niveau ouvert et chaque puzzle quotidien terminé sera oublié, et %@ repart à son premier puzzle. Rien de tout cela ne se récupère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni stella che hai ottenuto, ogni livello che hai aperto e ogni puzzle quotidiano che hai finito verrà dimenticato, e %@ torna al suo primo puzzle. Non si recupera nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得した星も、開いたレベルも、解いたデイリーパズルもすべて忘れられ、%@は最初のパズルに戻ります。元に戻すことはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estrela conquistada, cada nível aberto e cada quebra-cabeça diário concluído será esquecido, e %@ volta ao primeiro quebra-cabeça. Não há como recuperar."
          }
        }
      }
    },
    "Every world and every day is yours. Thank you for buying Pigpen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every world and every day is yours. Thank you for buying Pigpen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Welt und jeder Tag gehören dir. Danke, dass du Pigpen gekauft hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mundos y todos los días son tuyos. Gracias por comprar Pigpen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les mondes et tous les jours sont à toi. Merci d'avoir acheté Pigpen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mondo e ogni giorno sono tuoi. Grazie per aver acquistato Pigpen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての世界とすべての日があなたのものです。Pigpen をご購入いただきありがとうございます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os mundos e todos os dias são seus. Obrigado por comprar o Pigpen."
          }
        }
      }
    },

    "Pig began wondering how far he'd have to go to get away from rats.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig began wondering how far he'd have to go to get away from rats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig begann sich zu fragen, wie weit er wohl müsste, um den Ratten zu entkommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig empezó a preguntarse cuán lejos tendría que irse para librarse de las ratas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig commença à se demander jusqu'où il faudrait aller pour échapper aux rats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig iniziò a chiedersi quanto lontano dovesse andare per sfuggire ai ratti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネズミから逃れるにはどこまで行けばいいのか、Pig は考え始めました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig começou a se perguntar até onde teria que ir para fugir dos ratos."
          }
        }
      }
    },

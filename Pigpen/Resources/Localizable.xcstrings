          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye corrales separados para Pig y %1$@. Encierra %2$@ con un canal entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis des enclos séparés pour Pig et %1$@. Enferme %2$@ avec un cours d'eau entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci recinti separati per Pig e %1$@. Recinta %2$@ con un intero corso d'acqua."
          }
        },
        "ja": {
          "stringUnit": {

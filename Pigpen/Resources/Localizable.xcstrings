    "There is a barn beside the meadow's orchard. Get the pig that far and %lld outfits are hers to try on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a barn beside the meadow's orchard. Get the pig that far and %lld outfits are hers to try on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben dem Obstgarten der Wiese steht eine Scheune. Bring das Schwein so weit, und %lld Kostüme stehen ihr zum Anprobieren offen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto al huerto del prado hay un granero. Lleva al cerdo hasta allí y tendrá %lld atuendos para probarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À côté du verger de la prairie, il y a une grange. Mène le cochon jusque-là et %lld tenues seront à essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accanto al frutteto del prato c'è un fienile. Porta lì il maiale e %lld completi saranno tutti da provare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "草原の果樹園のそばに小屋があります。ブタをそこまで連れていけば、%lld着の衣装が試せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao lado do pomar do prado há um celeiro. Leve o porco até lá e %lld trajes ficam à disposição dela."
          }
        }
      }
    },

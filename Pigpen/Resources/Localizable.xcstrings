    "%@, about %@ in all — including the worlds you have not reached yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, about %@ in all — including the worlds you have not reached yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, insgesamt etwa %@ — auch die Welten, die du noch nicht erreicht hast."

    "Pen Windfall Orchard, the seventh stop in Mudlark Meadow, and the barn opens beside the trail.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pen Windfall Orchard, the seventh stop in Mudlark Meadow, and the barn opens beside the trail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zäune Windfall Orchard ein, die siebte Station in Mudlark Meadow, und die Scheune öffnet am Weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Windfall Orchard, la séptima parada de Mudlark Meadow, y el granero se abrirá junto al camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boucle Windfall Orchard, la septième étape de Mudlark Meadow, et la grange s'ouvrira au bord du sentier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recinta Windfall Orchard, la settima tappa di Mudlark Meadow, e il fienile si apre lungo il sentiero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudlark Meadow の7番目、Windfall Orchard を囲うと、道ばたの小屋が開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche Windfall Orchard, a sétima parada de Mudlark Meadow, e o celeiro abre ao lado da trilha."
          }
        }
      }
    },

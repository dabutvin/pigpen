    "Enable notifications to get daily reminders that help you build your streak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications to get daily reminders that help you build your streak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen für tägliche Erinnerungen, die dir helfen, deine Serie auszubauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones para recibir avisos diarios que te ayuden a mantener tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les notifications pour recevoir des rappels quotidiens qui t'aident à prolonger ta série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche per ricevere promemoria quotidiani che ti aiutano a far crescere la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をオンにすると、連続記録を伸ばすための毎日のお知らせが届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações para receber lembretes diários que ajudam a manter sua sequência."
          }
        }
      }
    },
    "Enable notifications to hear the moment your next free level opens in %@, and for a daily puzzle reminder each morning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications to hear the moment your next free level opens in %@, and for a daily puzzle reminder each morning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen, um zu erfahren, sobald dein nächstes kostenloses Level in %@ öffnet, und für eine tägliche Rätselerinnerung an jedem Morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones para enterarte en cuanto se abra tu próximo nivel gratuito en %@, y para recibir un aviso del puzle cada mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les notifications pour savoir dès que ton prochain niveau gratuit s'ouvre dans %@, et pour un rappel de puzzle chaque matin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche per sapere appena si apre il tuo prossimo livello gratuito in %@, e per un promemoria del puzzle ogni mattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をオンにすると、%@で次の無料レベルが開いた瞬間と、毎朝のパズルのお知らせが届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações para saber assim que seu próximo nível gratuito abrir em %@, e para um lembrete do quebra-cabeça toda manhã."
          }
        }
      }
    },

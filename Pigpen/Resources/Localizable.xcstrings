    "Something broken, something confusing, or an idea for the game — the support page has the common questions on it, and an address that reaches a person.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something broken, something confusing, or an idea for the game — the support page has the common questions on it, and an address that reaches a person."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas kaputt, etwas unklar oder eine Idee fürs Spiel — auf der Support-Seite stehen die häufigen Fragen und eine Adresse, hinter der ein Mensch sitzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo roto, algo confuso o una idea para el juego: la página de soporte tiene las dudas habituales y una dirección donde hay una persona al otro lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bug, quelque chose d'obscur ou une idée pour le jeu — la page d'aide regroupe les questions fréquentes et une adresse derrière laquelle il y a quelqu'un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa di rotto, qualcosa di poco chiaro o un'idea per il gioco: la pagina di assistenza ha le domande frequenti e un indirizzo dietro cui c'è una persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不具合、わかりにくい点、あるいはアイデア。サポートページによくある質問と、人が読んでいる連絡先があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo quebrado, algo confuso ou uma ideia para o jogo — a página de suporte tem as dúvidas comuns e um endereço com uma pessoa do outro lado."
          }
        }
      }
    },

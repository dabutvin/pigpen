    "Every daily puzzle so far is here. Each new day unlocks when it arrives.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every daily puzzle so far is here. Each new day unlocks when it arrives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes bisherige Tagesrätsel steht hier. Jeder neue Tag wird freigeschaltet, wenn er kommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí está cada puzle diario hasta ahora. Cada nuevo día se abre cuando llega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les puzzles quotidiens parus sont ici. Chaque nouveau jour s'ouvre à son arrivée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui c'è ogni puzzle quotidiano finora. Ogni nuovo giorno si apre quando arriva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでのデイリーパズルはすべてここに。新しい日は、その日になると開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os quebra-cabeças diários até agora estão aqui. Cada novo dia abre quando chega."
          }
        }
      }
    },
    "Every daily puzzle there has been, a month at a time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every daily puzzle there has been, a month at a time"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Tagesrätsel, das es gab, Monat für Monat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los puzles diarios que ha habido, mes a mes"
          }
        },
        "fr": {
          "stringUnit": {

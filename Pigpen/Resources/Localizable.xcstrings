    "Lotus flowers add a lovely pop of color. The mosquito situation is difficult to overlook.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lotus flowers add a lovely pop of color. The mosquito situation is difficult to overlook."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lotusblüten setzen einen reizenden Farbtupfer. Die Mückenlage lässt sich schwer übersehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores de loto aportan un toque de color precioso. Lo de los mosquitos cuesta pasarlo por alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs de lotus apportent une jolie touche de couleur. Le dossier moustiques est difficile à ignorer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fiori di loto danno un bel tocco di colore. La questione zanzare è difficile da ignorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハスの花は彩りを添えます。蚊の件は見過ごしがたい。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As flores de lótus dão um belo toque de cor. A questão dos mosquitos é difícil de ignorar."
          }
        }
      }
    },
    "Make it %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {

    "Pig decided he'd had enough of sand, surf, and surprise crustaceans.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig decided he'd had enough of sand, surf, and surprise crustaceans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig hatte genug von Sand, Brandung und überraschenden Krebstieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig decidió que ya había tenido bastante arena, oleaje y crustáceos sorpresa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig en avait assez du sable, des vagues et des crustacés surprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig decise di averne abbastanza di sabbia, onde e crostacei a sorpresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "砂と波と不意の甲殻類には、Pig もうんざりしました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pig decidiu que já bastava de areia, ondas e crustáceos surpresa."
          }
        }
      }
    },
    "Pig decided to try somewhere with less ice.": {

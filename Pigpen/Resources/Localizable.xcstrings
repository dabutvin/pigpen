    "Deep dark, and something with wings. Diamonds in the flowstone, boulders on it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep dark, and something with wings. Diamonds in the flowstone, boulders on it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefes Dunkel und etwas mit Flügeln. Diamanten im Sinterstein, Felsbrocken darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuridad profunda y algo con alas. Diamantes en la colada, rocas encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ténèbres profondes, et quelque chose qui a des ailes. Des diamants dans la roche, des rochers dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buio profondo, e qualcosa con le ali. Diamanti nella roccia, massi sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深い闇と、翼のある何か。流れ石にダイヤ、その上に岩。"

          "stringUnit": {
            "state": "translated",
            "value": "Un arcobaleno conquista subito. Il maltempo è un difetto notevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "虹は即座に魅力を添えます。荒天は明白な難点。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arco-íris agrega charme na hora. O mau tempo é um ponto negativo notável."
          }
        }
      }
    },
    "A reminder at %@ on any morning you have not yet finished the day's puzzle, and one the moment your next free level opens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder at %@ on any morning you have not yet finished the day's puzzle, and one the moment your next free level opens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung um %@ an jedem Morgen, an dem du das Tagesrätsel noch nicht gelöst hast, und eine, sobald dein nächstes kostenloses Level öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso a las %@ cualquier mañana en la que aún no hayas terminado el puzle del día, y otro en cuanto se abra tu próximo nivel gratuito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel à %@ chaque matin où tu n'as pas encore terminé le puzzle du jour, et un autre dès que ton prochain niveau gratuit s'ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria alle %@ ogni mattina in cui non hai ancora finito il puzzle del giorno, e uno appena si apre il tuo prossimo livello gratuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日のパズルが未完了の朝は%@に、そして次の無料レベルが開いた瞬間にも通知します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete às %@ em toda manhã em que você ainda não tiver terminado o quebra-cabeça do dia, e outro assim que seu próximo nível gratuito abrir."
          }
        }
      }
    },

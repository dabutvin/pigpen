          }
        }
      }
    },
    "Make sure your fence is completely closed. Leave a gap and Pig will wander off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your fence is completely closed. Leave a gap and Pig will wander off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass dein Zaun ganz geschlossen ist. Bleibt eine Lücke, spaziert Pig davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la valla quede bien cerrada. Si dejas un hueco, Pig se largará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que ta clôture est bien fermée. S'il reste un trou, Pig s'en ira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che la recinzione sia del tutto chiusa. Se resta un varco, Pig se ne va."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柵は完全に閉じること。隙間があれば Pig は出ていきます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanta que a cerca esteja totalmente fechada. Se sobrar uma brecha, Pig vai embora."
          }
        }
      }
    },
    "Mirebog Fen. Waterfront property in every direction.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen. Waterfront property in every direction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen. Wasserlage in alle Richtungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen. Primera línea de agua en todas direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen. Front d'eau dans toutes les directions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen. Fronte acqua in ogni direzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen。全方位が水辺の物件。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirebog Fen. Beira-d'água em todas as direções."
          }
        }
      }
    },
    "More space means a better score. Apples improve the property. Skulls hurt the resale value.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More space means a better score. Apples improve the property. Skulls hurt the resale value."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Fläche bringt mehr Punkte. Äpfel werten das Objekt auf. Totenköpfe drücken den Wiederverkaufswert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más espacio, mejor puntuación. Las manzanas revalorizan la finca. Las calaveras hunden la reventa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus d'espace, meilleur score. Les pommes valorisent le bien. Les crânes plombent la revente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più spazio, punteggio più alto. Le mele valorizzano l'immobile. I teschi affossano la rivendita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広いほど高得点。リンゴは資産価値を上げ、ドクロは下げます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais espaço, melhor pontuação. Maçãs valorizam o imóvel. Caveiras derrubam a revenda."
          }
        }
      }
    },
    "Much less.": {
      "extractionState": "manual",
      "localizations": {
        "en": {

    "A mountain that never stops smoking. Coins in the ash, flames under it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mountain that never stops smoking. Coins in the ash, flames under it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Berg, der nie aufhört zu rauchen. Münzen in der Asche, Flammen darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
